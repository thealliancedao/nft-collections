 "rules": {
  "replay_order": "by height, then acquisition → return-from-custody → transfer → custody-entry → destruction (a wallet cannot move what it has not received), then msg_index",
  "custodian_moves": "a wallet's transfer/stake into a registry custodian = state change (staked / staked_enterprise / staked:<role>), the custodian's transfer back = liquid, a custodian→custodian move re-labels the holder's state (role: holder)",
  "acquire_when_to": [
   "lock_create",
   "lock_split",
   "lock_transfer",
   "mint",
   "mint_purchase",
   "sale",
   "transfer"
  ],
  "release_when_from": [
   "burn",
   "lock_transfer",
   "lock_withdraw",
   "sale",
   "transfer"
  ],
  "state_when_from": [
   "list",
   "stake",
   "stake_enterprise",
   "venue_in",
   "break"
  ],
  "state_when_to": [
   "delist",
   "claim",
   "unstake",
   "unstake_enterprise",
   "venue_out"
  ],
  "states": [
   "liquid",
   "listed:<venue>",
   "staked",
   "staked_enterprise",
   "unstaking",
   "escrow:<venue>",
   "locked"
  ]
 },
